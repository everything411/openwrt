# Wi-Fi data path.  The default is the offload path: the service loads the
# NSS driver and the radios with nss_offload=1 at boot.
#
#   mode 'offload'      persistent; a failed attempt falls back to host
#   mode 'host'         only load the drivers; never write boot=1
#   mode 'offload-once' one armed attempt; the service disarms it before it
#                       touches the core, so a hang costs one boot
#
# mode=offload is disarmed to host before the core is touched and restored
# only after a complete start.  A hang or failed bring-up therefore leaves
# the next boot on the host path, and only a success restores offload.
# nss-wifi-arm and nss-wifi-promote remain for one-shot bring-up.
#
# 'firmware' is the NSS firmware line booted: '12.5', or '11.4', the line that
# forwards an 802.11s mesh.
#
# debug=0 is the default: a firmware fault restarts the core.  debug=1 writes
# fault_restart=0 for a watched bring-up, so a fault halts the core instead.
# auto_promote=1 lets a successful offload-once boot promote itself after
# 120 s; debug images keep it at 0.  no_ahb=1 is for a QCN9074-only bring-up
# and skips ath11k_ahb.
#
# With CONFIG_ATH11K_NSS_WIFI set, ath11k_ahb and ath11k_pci no longer
# autoload: this service loads them.  If the nss-wifi service is disabled,
# modprobe them by hand (ath11k first, then the bus module).
config general 'general'
	option mode 'offload'
	option offload '1'
	option debug '0'
	option auto_promote '0'
	option no_ahb '0'
	option firmware '12.5'
